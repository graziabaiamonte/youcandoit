# Copy to .env and adjust. Everything works with no .env at all (Ollama in Docker).

# Use a native Ollama install on macOS (faster: Docker on Mac has no GPU access)
# OLLAMA_URL=http://host.docker.internal:11434

# Models pulled by the ollama-pull service and used by the API
# OLLAMA_CHAT_MODEL=llama3.2:3b
# OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional: use Claude for chat (paid). Embeddings stay on Ollama.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Force a provider: ollama | anthropic | fake
# LLM_PROVIDER=
