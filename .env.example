# Copy to .env and adjust. With no .env, start Ollama in Docker: docker compose --profile ollama up -d

# Use a native Ollama install on macOS (faster: Docker on Mac has no GPU access)
# OLLAMA_URL=http://host.docker.internal:11434

# Models pulled by the ollama-pull service and used by the API
# OLLAMA_CHAT_MODEL=llama3.2:3b
# OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional: use Claude for chat (paid). Embeddings stay on Ollama.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Force a provider: ollama | anthropic | fake
# LLM_PROVIDER=

# Background jobs (news 07:00, source indexing 03:00) and their timezone
# SCHEDULER_ENABLED=true
# TIMEZONE=Europe/Rome

# Origins allowed to call the API directly (the web app goes through its /api proxy)
# CORS_ORIGINS=["http://localhost:3000"]
